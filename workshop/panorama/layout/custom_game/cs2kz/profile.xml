<!-- Every run row is written out because layouts have no loops.
     The count must match KZ_PROFILE_ROWS in profile.h. -->
<root>
  <styles>
    <include src="file://{resources}/styles/custom_game/cs2kz/profile.css" />
  </styles>
  <Panel class="root" hittest="false">
    <Panel id="profile_root" class="kz-window-root hidden" hittest="false">
      <Panel id="profile_window" class="kz-window profile-window">
        <Panel class="kz-filters">
          <Panel id="profile_mode" class="kz-segment">
            <Panel class="kz-segment-thumb" hittest="false" />
            <Panel class="kz-segment-options">
              <Button id="profile_mode_0" class="kz-segment-option">
                <Label class="kz-segment-label" text="CKZ" hittest="false" />
              </Button>
              <Button id="profile_mode_1" class="kz-segment-option">
                <Label class="kz-segment-label" text="VNL" hittest="false" />
              </Button>
            </Panel>
          </Panel>
          <Panel class="kz-rule-v" />
          <Panel id="profile_type" class="kz-segment tones">
            <Panel class="kz-segment-thumb" hittest="false" />
            <Panel class="kz-segment-options">
              <Button id="profile_type_0" class="kz-segment-option">
                <Label id="profile_type_0_label" class="kz-segment-label" text="{s:profile_type_0_label}" hittest="false" />
              </Button>
              <Button id="profile_type_1" class="kz-segment-option">
                <Label id="profile_type_1_label" class="kz-segment-label" text="{s:profile_type_1_label}" hittest="false" />
              </Button>
            </Panel>
          </Panel>
          <Panel class="fill" />
          <Panel id="profile_scope" class="kz-segment hidden">
            <Panel class="kz-segment-thumb" hittest="false" />
            <Panel class="kz-segment-options">
              <Button id="profile_scope_0" class="kz-segment-option">
                <Label id="profile_scope_0_label" class="kz-segment-label" text="{s:profile_scope_0_label}" hittest="false" />
              </Button>
              <Button id="profile_scope_1" class="kz-segment-option">
                <Label id="profile_scope_1_label" class="kz-segment-label" text="{s:profile_scope_1_label}" hittest="false" />
              </Button>
            </Panel>
          </Panel>
          <Button id="profile_window_close" class="kz-window-close" />
        </Panel>
        <Label id="profile_status" class="kz-table-status" text="{s:profile_status}" />
        <Panel id="profile_card" class="profile-card hidden">
          <Panel class="profile-name-row">
            <Label id="profile_name" class="profile-name" text="{s:profile_name}" />
            <Button id="profile_steamid" class="kz-icon-btn icon-copy tip-right">
              <Panel class="kz-icon-btn-face" hittest="false" />
              <Panel class="kz-icon-btn-icon" hittest="false" />
              <Panel class="kz-tooltip-anchor" hittest="false">
                <Label id="profile_steamid_tip" class="kz-tooltip" text="{s:profile_steamid_tip}" hittest="false" />
              </Panel>
            </Button>
          </Panel>
          <Panel class="profile-line">
            <Label id="profile_joined_label" class="profile-joined-label" text="{s:profile_joined_label}" />
            <Label id="profile_joined" class="profile-joined" text="{s:profile_joined}" />
          </Panel>
          <Panel id="profile_global_line" class="profile-line hidden">
            <Label id="profile_global_label" class="profile-rank-label" text="{s:profile_global_label}" />
            <Label id="profile_global_rank" class="profile-global-rank" text="{s:profile_global_rank}" />
