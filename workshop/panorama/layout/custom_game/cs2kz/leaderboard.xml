<!-- Every row is written out because layouts have no loops.
     The count must match KZ_LEADERBOARD_ROWS. -->
<root>
  <styles>
    <include src="file://{resources}/styles/custom_game/cs2kz/leaderboard.css" />
  </styles>
  <Panel class="root" hittest="false">
    <Panel id="leaderboard_root" class="kz-window-root hidden" hittest="false">
      <Panel id="leaderboard_window" class="kz-window leaderboard-window">
        <Panel class="kz-window-header">
          <Label id="leaderboard_window_title" class="kz-window-title" text="{s:leaderboard_window_title}" />
          <Button id="leaderboard_window_close" class="kz-window-close" />
        </Panel>
        <Panel class="kz-filters">
          <Panel id="leaderboard_mode" class="kz-segment">
            <Panel class="kz-segment-thumb" hittest="false" />
            <Panel class="kz-segment-options">
              <Button id="leaderboard_mode_0" class="kz-segment-option">
                <Label class="kz-segment-label" text="CKZ" hittest="false" />
              </Button>
              <Button id="leaderboard_mode_1" class="kz-segment-option">
                <Label class="kz-segment-label" text="VNL" hittest="false" />
              </Button>
            </Panel>
          </Panel>
        </Panel>
        <Panel class="kz-record-table">
          <Panel class="kz-record-head">
            <Label class="kz-record-th lb-col-num" text="#" />
            <Label id="leaderboard_th_player" class="kz-record-th lb-col-player" text="{s:leaderboard_th_player}" />
            <Label id="leaderboard_th_rating" class="kz-record-th lb-col-rating" text="{s:leaderboard_th_rating}" />
            <Label id="leaderboard_th_title" class="kz-record-th lb-col-title" text="{s:leaderboard_th_title}" />
          </Panel>
          <Panel id="leaderboard_row0" class="kz-record-row first hidden">
            <Label id="leaderboard_row0_num" class="kz-record-cell lb-col-num" text="{s:leaderboard_row0_num}" />
            <Panel class="lb-col-player kz-record-player">
              <Button id="leaderboard_row0_profile" class="kz-name-btn">
                <Label id="leaderboard_row0_player" class="kz-record-cell kz-record-name" text="{s:leaderboard_row0_player}" hittest="false" />
              </Button>
            </Panel>
            <Label id="leaderboard_row0_rating" class="kz-record-cell kz-rank-rating lb-col-rating" text="{s:leaderboard_row0_rating}" />
            <Panel class="lb-col-title">
              <Label id="leaderboard_row0_title" class="kz-rank-badge" text="{s:leaderboard_row0_title}" />
            </Panel>
          </Panel>
          <Panel id="leaderboard_row1" class="kz-record-row hidden">
            <Label id="leaderboard_row1_num" class="kz-record-cell lb-col-num" text="{s:leaderboard_row1_num}" />
            <Panel class="lb-col-player kz-record-player">
              <Button id="leaderboard_row1_profile" class="kz-name-btn">
                <Label id="leaderboard_row1_player" class="kz-record-cell kz-record-name" text="{s:leaderboard_row1_player}" hittest="false" />
              </Button>
            </Panel>
            <Label id="leaderboard_row1_rating" class="kz-record-cell kz-rank-rating lb-col-rating" text="{s:leaderboard_row1_rating}" />
            <Panel class="lb-col-title">
              <Label id="leaderboard_row1_title" class="kz-rank-badge" text="{s:leaderboard_row1_title}" />
            </Panel>
          </Panel>
          <Panel id="leaderboard_row2" class="kz-record-row hidden">
            <Label id="leaderboard_row2_num" class="kz-record-cell lb-col-num" text="{s:leaderboard_row2_num}" />
            <Panel class="lb-col-player kz-record-player">
              <Button id="leaderboard_row2_profile" class="kz-name-btn">
                <Label id="leaderboard_row2_player" class="kz-record-cell kz-record-name" text="{s:leaderboard_row2_player}" hittest="false" />
              </Button>
            </Panel>
            <Label id="leaderboard_row2_rating" class="kz-record-cell kz-rank-rating lb-col-rating" text="{s:leaderboard_row2_rating}" />
            <Panel class="lb-col-title">
              <Label id="leaderboard_row2_title" class="kz-rank-badge" text="{s:leaderboard_row2_title}" />
            </Panel>
          </Panel>
          <Panel id="leaderboard_row3" class="kz-record-row hidden">
            <Label id="leaderboard_row3_num" class="kz-record-cell lb-col-num" text="{s:leaderboard_row3_num}" />
            <Panel class="lb-col-player kz-record-player">
              <Button id="leaderboard_row3_profile" class="kz-name-btn">
                <Label id="leaderboard_row3_player" class="kz-record-cell kz-record-name" text="{s:leaderboard_row3_player}" hittest="false" />
              </Button>
            </Panel>
            <Label id="leaderboard_row3_rating" class="kz-record-cell kz-rank-rating lb-col-rating" text="{s:leaderboard_row3_rating}" />
            <Panel class="lb-col-title">
              <Label id="leaderboard_row3_title" class="kz-rank-badge" text="{s:leaderboard_row3_title}" />
