            </Panel>
          </Panel>
          <Panel id="leaderboard_row5" class="kz-record-row hidden">
            <Label id="leaderboard_row5_num" class="kz-record-cell lb-col-num" text="{s:leaderboard_row5_num}" />
            <Panel class="lb-col-player kz-record-player">
              <Button id="leaderboard_row5_profile" class="kz-name-btn">
                <Label id="leaderboard_row5_player" class="kz-record-cell kz-record-name" text="{s:leaderboard_row5_player}" hittest="false" />
              </Button>
            </Panel>
            <Label id="leaderboard_row5_rating" class="kz-record-cell kz-rank-rating lb-col-rating" text="{s:leaderboard_row5_rating}" />
            <Panel class="lb-col-title">
              <Label id="leaderboard_row5_title" class="kz-rank-badge" text="{s:leaderboard_row5_title}" />
            </Panel>
          </Panel>
          <Panel id="leaderboard_row6" class="kz-record-row hidden">
            <Label id="leaderboard_row6_num" class="kz-record-cell lb-col-num" text="{s:leaderboard_row6_num}" />
            <Panel class="lb-col-player kz-record-player">
              <Button id="leaderboard_row6_profile" class="kz-name-btn">
                <Label id="leaderboard_row6_player" class="kz-record-cell kz-record-name" text="{s:leaderboard_row6_player}" hittest="false" />
              </Button>
            </Panel>
            <Label id="leaderboard_row6_rating" class="kz-record-cell kz-rank-rating lb-col-rating" text="{s:leaderboard_row6_rating}" />
            <Panel class="lb-col-title">
              <Label id="leaderboard_row6_title" class="kz-rank-badge" text="{s:leaderboard_row6_title}" />
            </Panel>
          </Panel>
          <Panel id="leaderboard_row7" class="kz-record-row hidden">
            <Label id="leaderboard_row7_num" class="kz-record-cell lb-col-num" text="{s:leaderboard_row7_num}" />
            <Panel class="lb-col-player kz-record-player">
              <Button id="leaderboard_row7_profile" class="kz-name-btn">
                <Label id="leaderboard_row7_player" class="kz-record-cell kz-record-name" text="{s:leaderboard_row7_player}" hittest="false" />
              </Button>
            </Panel>
            <Label id="leaderboard_row7_rating" class="kz-record-cell kz-rank-rating lb-col-rating" text="{s:leaderboard_row7_rating}" />
            <Panel class="lb-col-title">
              <Label id="leaderboard_row7_title" class="kz-rank-badge" text="{s:leaderboard_row7_title}" />
            </Panel>
          </Panel>
          <Panel id="leaderboard_row8" class="kz-record-row hidden">
            <Label id="leaderboard_row8_num" class="kz-record-cell lb-col-num" text="{s:leaderboard_row8_num}" />
            <Panel class="lb-col-player kz-record-player">
              <Button id="leaderboard_row8_profile" class="kz-name-btn">
                <Label id="leaderboard_row8_player" class="kz-record-cell kz-record-name" text="{s:leaderboard_row8_player}" hittest="false" />
              </Button>
            </Panel>
            <Label id="leaderboard_row8_rating" class="kz-record-cell kz-rank-rating lb-col-rating" text="{s:leaderboard_row8_rating}" />
            <Panel class="lb-col-title">
              <Label id="leaderboard_row8_title" class="kz-rank-badge" text="{s:leaderboard_row8_title}" />
            </Panel>
          </Panel>
          <Panel id="leaderboard_row9" class="kz-record-row hidden">
            <Label id="leaderboard_row9_num" class="kz-record-cell lb-col-num" text="{s:leaderboard_row9_num}" />
            <Panel class="lb-col-player kz-record-player">
              <Button id="leaderboard_row9_profile" class="kz-name-btn">
                <Label id="leaderboard_row9_player" class="kz-record-cell kz-record-name" text="{s:leaderboard_row9_player}" hittest="false" />
              </Button>
            </Panel>
            <Label id="leaderboard_row9_rating" class="kz-record-cell kz-rank-rating lb-col-rating" text="{s:leaderboard_row9_rating}" />
            <Panel class="lb-col-title">
              <Label id="leaderboard_row9_title" class="kz-rank-badge" text="{s:leaderboard_row9_title}" />
            </Panel>
          </Panel>
          <Label id="leaderboard_status" class="kz-table-status" text="{s:leaderboard_status}" />
        </Panel>
        <Panel class="kz-pager">
          <Label id="leaderboard_count" class="kz-pager-count" text="{s:leaderboard_count}" />
          <Panel class="fill" />
          <Button id="leaderboard_prev" class="kz-btn">
            <Label id="leaderboard_prev_label" class="kz-btn-label" text="{s:leaderboard_prev_label}" hittest="false" />
          </Button>
          <Button id="leaderboard_next" class="kz-btn">
            <Label id="leaderboard_next_label" class="kz-btn-label" text="{s:leaderboard_next_label}" hittest="false" />
          </Button>
        </Panel>
      </Panel>
    </Panel>
  </Panel>
</root>
