<root>
  <styles>
    <include src="file://{resources}/styles/custom_game/cs2kz/mhud.css" />
  </styles>
  <Panel class="root" hittest="false">
    <Label id="mhud_timer" class="element hidden" text="{s:timer}" hittest="false" />
    <Label id="mhud_speed" class="element speed hidden" text="{s:speed}" hittest="false" />
    <Label id="mhud_prespeed" class="element prespeed hidden" text="{s:prespeed}" hittest="false" />
    <Panel id="mhud_keys" class="element keys hidden" hittest="false">
      <Panel class="key-row key-row-1" hittest="false">
        <Panel id="mhud_key_c" class="key-button" hittest="false">
          <Label class="key-glyph key-glyph-main" text="C" hittest="false"></Label>
          <Label class="key-glyph key-glyph-idle" text="—" hittest="false"></Label>
        </Panel>
        <Panel id="mhud_key_w" class="key-button key-button-middle" hittest="false">
          <Label class="key-glyph key-glyph-main key-glyph-arrow" text="↑" hittest="false"></Label>
          <Label class="key-glyph key-glyph-main key-glyph-letter" text="W" hittest="false"></Label>
          <Label class="key-glyph key-glyph-idle" text="—" hittest="false"></Label>
        </Panel>
        <Panel id="mhud_key_j" class="key-button key-button-jump" hittest="false">
          <Label class="key-glyph key-glyph-main" text="J" hittest="false"></Label>
          <Label class="key-glyph key-glyph-idle" text="—" hittest="false"></Label>
        </Panel>
      </Panel>
      <Panel class="key-row" hittest="false">
        <Panel id="mhud_key_a" class="key-button" hittest="false">
          <Label class="key-glyph key-glyph-main key-glyph-arrow" text="←" hittest="false"></Label>
          <Label class="key-glyph key-glyph-main key-glyph-letter" text="A" hittest="false"></Label>
          <Label class="key-glyph key-glyph-idle" text="—" hittest="false"></Label>
        </Panel>
        <Panel id="mhud_key_s" class="key-button key-button-middle" hittest="false">
          <Label class="key-glyph key-glyph-main key-glyph-arrow" text="↓" hittest="false"></Label>
          <Label class="key-glyph key-glyph-main key-glyph-letter" text="S" hittest="false"></Label>
          <Label class="key-glyph key-glyph-idle" text="—" hittest="false"></Label>
        </Panel>
        <Panel id="mhud_key_d" class="key-button" hittest="false">
          <Label class="key-glyph key-glyph-main key-glyph-arrow" text="→" hittest="false"></Label>
          <Label class="key-glyph key-glyph-main key-glyph-letter" text="D" hittest="false"></Label>
          <Label class="key-glyph key-glyph-idle" text="—" hittest="false"></Label>
        </Panel>
      </Panel>
    </Panel>
    <Label id="mhud_checkpoint" class="element checkpoint hidden" text="{s:checkpoint}" hittest="false" />
    <Panel id="mhud_crosshair" class="crosshair hidden" hittest="false">
      <Panel class="xh-half-left" hittest="false">
        <Panel id="xh_left" class="xh-arm" hittest="false" />
      </Panel>
      <Panel class="xh-half-right" hittest="false">
        <Panel id="xh_right" class="xh-arm" hittest="false" />
      </Panel>
      <Panel class="xh-half-top" hittest="false">
        <Panel id="xh_top" class="xh-arm" hittest="false" />
      </Panel>
      <Panel class="xh-half-bottom" hittest="false">
        <Panel id="xh_bottom" class="xh-arm" hittest="false" />
      </Panel>
      <Panel id="xh_dot" class="xh-arm xh-dot hidden" hittest="false" />
    </Panel>

  </Panel>
</root>
