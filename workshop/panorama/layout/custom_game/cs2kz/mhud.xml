<root>
  <styles>
    <include src="file://{resources}/styles/custom_game/cs2kz/mhud.css" />
  </styles>
  <Panel class="root" hittest="false">
    <Panel id="mhud_timer_pos" class="pos" hittest="false">
      <Label id="mhud_timer" class="element hidden" text="{s:timer}" hittest="false" />
      <Panel id="mhud_timer_hit" class="element edit-box hidden" hittest="false">
        <Button id="mhud_timer_hit_move" class="edit-hit" />
        <Button id="mhud_timer_hit_tl" class="edit-corner edit-corner-tl" />
        <Button id="mhud_timer_hit_tr" class="edit-corner edit-corner-tr" />
        <Button id="mhud_timer_hit_bl" class="edit-corner edit-corner-bl" />
        <Button id="mhud_timer_hit_br" class="edit-corner edit-corner-br" />
      </Panel>
    </Panel>
    <Panel id="mhud_speed_pos" class="pos" hittest="false">
      <Label id="mhud_speed" class="element speed hidden" text="{s:speed}" hittest="false" />
      <Panel id="mhud_speed_hit" class="element edit-box hidden" hittest="false">
        <Button id="mhud_speed_hit_move" class="edit-hit" />
        <Button id="mhud_speed_hit_tl" class="edit-corner edit-corner-tl" />
        <Button id="mhud_speed_hit_tr" class="edit-corner edit-corner-tr" />
        <Button id="mhud_speed_hit_bl" class="edit-corner edit-corner-bl" />
        <Button id="mhud_speed_hit_br" class="edit-corner edit-corner-br" />
      </Panel>
    </Panel>
    <Panel id="mhud_prespeed_pos" class="pos" hittest="false">
      <Label id="mhud_prespeed" class="element prespeed hidden" text="{s:prespeed}" hittest="false" />
      <Panel id="mhud_prespeed_hit" class="element edit-box hidden" hittest="false">
        <Button id="mhud_prespeed_hit_move" class="edit-hit" />
        <Button id="mhud_prespeed_hit_tl" class="edit-corner edit-corner-tl" />
        <Button id="mhud_prespeed_hit_tr" class="edit-corner edit-corner-tr" />
        <Button id="mhud_prespeed_hit_bl" class="edit-corner edit-corner-bl" />
        <Button id="mhud_prespeed_hit_br" class="edit-corner edit-corner-br" />
      </Panel>
    </Panel>
    <Panel id="mhud_keys_pos" class="pos" hittest="false">
      <Panel id="mhud_keys" class="element keys hidden" hittest="false">
        <Panel class="key-row key-row-1" hittest="false">
          <Panel id="mhud_key_c" class="key-button" hittest="false">
            <Label id="mhud_kg_c_main" class="key-glyph key-glyph-main" text="C" hittest="false"></Label>
            <Label id="mhud_kg_c_idle" class="key-glyph key-glyph-idle" text="—" hittest="false"></Label>
          </Panel>
          <Panel id="mhud_key_w" class="key-button key-button-middle" hittest="false">
            <Label id="mhud_kg_w_main" class="key-glyph key-glyph-main key-glyph-arrow" text="↑" hittest="false"></Label>
            <Label id="mhud_kg_w_letter" class="key-glyph key-glyph-main key-glyph-letter" text="W" hittest="false"></Label>
            <Label id="mhud_kg_w_idle" class="key-glyph key-glyph-idle" text="—" hittest="false"></Label>
          </Panel>
          <Panel id="mhud_key_j" class="key-button key-button-jump" hittest="false">
            <Label id="mhud_kg_j_main" class="key-glyph key-glyph-main" text="J" hittest="false"></Label>
            <Label id="mhud_kg_j_idle" class="key-glyph key-glyph-idle" text="—" hittest="false"></Label>
          </Panel>
        </Panel>
        <Panel class="key-row" hittest="false">
          <Panel id="mhud_key_a" class="key-button" hittest="false">
            <Label id="mhud_kg_a_main" class="key-glyph key-glyph-main key-glyph-arrow" text="←" hittest="false"></Label>
            <Label id="mhud_kg_a_letter" class="key-glyph key-glyph-main key-glyph-letter" text="A" hittest="false"></Label>
            <Label id="mhud_kg_a_idle" class="key-glyph key-glyph-idle" text="—" hittest="false"></Label>
          </Panel>
          <Panel id="mhud_key_s" class="key-button key-button-middle" hittest="false">
            <Label id="mhud_kg_s_main" class="key-glyph key-glyph-main key-glyph-arrow" text="↓" hittest="false"></Label>
            <Label id="mhud_kg_s_letter" class="key-glyph key-glyph-main key-glyph-letter" text="S" hittest="false"></Label>
            <Label id="mhud_kg_s_idle" class="key-glyph key-glyph-idle" text="—" hittest="false"></Label>
          </Panel>
          <Panel id="mhud_key_d" class="key-button" hittest="false">
            <Label id="mhud_kg_d_main" class="key-glyph key-glyph-main key-glyph-arrow" text="→" hittest="false"></Label>
            <Label id="mhud_kg_d_letter" class="key-glyph key-glyph-main key-glyph-letter" text="D" hittest="false"></Label>
            <Label id="mhud_kg_d_idle" class="key-glyph key-glyph-idle" text="—" hittest="false"></Label>
          </Panel>
        </Panel>
      </Panel>
      <Panel id="mhud_keys_hit" class="element edit-box hidden" hittest="false">
        <Button id="mhud_keys_hit_move" class="edit-hit" />
        <Button id="mhud_keys_hit_tl" class="edit-corner edit-corner-tl" />
        <Button id="mhud_keys_hit_tr" class="edit-corner edit-corner-tr" />
        <Button id="mhud_keys_hit_bl" class="edit-corner edit-corner-bl" />
        <Button id="mhud_keys_hit_br" class="edit-corner edit-corner-br" />
      </Panel>
    </Panel>
    <Panel id="mhud_checkpoint_pos" class="pos" hittest="false">
      <Label id="mhud_checkpoint" class="element checkpoint hidden" text="{s:checkpoint}" hittest="false" />
      <Panel id="mhud_checkpoint_hit" class="element edit-box hidden" hittest="false">
        <Button id="mhud_checkpoint_hit_move" class="edit-hit" />
        <Button id="mhud_checkpoint_hit_tl" class="edit-corner edit-corner-tl" />
        <Button id="mhud_checkpoint_hit_tr" class="edit-corner edit-corner-tr" />
        <Button id="mhud_checkpoint_hit_bl" class="edit-corner edit-corner-bl" />
        <Button id="mhud_checkpoint_hit_br" class="edit-corner edit-corner-br" />
      </Panel>
    </Panel>
    <Panel id="mhud_perf_pos" class="pos" hittest="false">
      <Label id="mhud_perf" class="element hidden" text="{s:perf}" hittest="false" />
      <Panel id="mhud_perf_hit" class="element edit-box hidden" hittest="false">
        <Button id="mhud_perf_hit_move" class="edit-hit" />
        <Button id="mhud_perf_hit_tl" class="edit-corner edit-corner-tl" />
        <Button id="mhud_perf_hit_tr" class="edit-corner edit-corner-tr" />
        <Button id="mhud_perf_hit_bl" class="edit-corner edit-corner-bl" />
        <Button id="mhud_perf_hit_br" class="edit-corner edit-corner-br" />
      </Panel>
    </Panel>
    <Panel id="mhud_cj_pos" class="pos" hittest="false">
      <Label id="mhud_cj" class="element hidden" text="{s:cj}" hittest="false" />
      <Panel id="mhud_cj_hit" class="element edit-box hidden" hittest="false">
        <Button id="mhud_cj_hit_move" class="edit-hit" />
        <Button id="mhud_cj_hit_tl" class="edit-corner edit-corner-tl" />
        <Button id="mhud_cj_hit_tr" class="edit-corner edit-corner-tr" />
        <Button id="mhud_cj_hit_bl" class="edit-corner edit-corner-bl" />
        <Button id="mhud_cj_hit_br" class="edit-corner edit-corner-br" />
      </Panel>
    </Panel>
    <Panel id="mhud_jumpbug_pos" class="pos" hittest="false">
      <Label id="mhud_jumpbug" class="element hidden" text="{s:jumpbug}" hittest="false" />
      <Panel id="mhud_jumpbug_hit" class="element edit-box hidden" hittest="false">
        <Button id="mhud_jumpbug_hit_move" class="edit-hit" />
        <Button id="mhud_jumpbug_hit_tl" class="edit-corner edit-corner-tl" />
        <Button id="mhud_jumpbug_hit_tr" class="edit-corner edit-corner-tr" />
        <Button id="mhud_jumpbug_hit_bl" class="edit-corner edit-corner-bl" />
        <Button id="mhud_jumpbug_hit_br" class="edit-corner edit-corner-br" />
      </Panel>
    </Panel>

    <Panel id="mhud_js" class="js-stack" hittest="false">
      <Panel class="js-history" hittest="false">
        <Panel id="mhud_js_h0" class="js-hist" hittest="false"><Label id="mhud_js_h0_t" class="js-hist-type" text="{s:v}" hittest="false" /><Label id="mhud_js_h0_i" class="js-hist-info" text="{s:v}" hittest="false" /><Label id="mhud_js_h0_d" class="js-hist-dist" text="{s:v}" hittest="false" /></Panel>
        <Panel id="mhud_js_h1" class="js-hist" hittest="false"><Label id="mhud_js_h1_t" class="js-hist-type" text="{s:v}" hittest="false" /><Label id="mhud_js_h1_i" class="js-hist-info" text="{s:v}" hittest="false" /><Label id="mhud_js_h1_d" class="js-hist-dist" text="{s:v}" hittest="false" /></Panel>
        <Panel id="mhud_js_h2" class="js-hist" hittest="false"><Label id="mhud_js_h2_t" class="js-hist-type" text="{s:v}" hittest="false" /><Label id="mhud_js_h2_i" class="js-hist-info" text="{s:v}" hittest="false" /><Label id="mhud_js_h2_d" class="js-hist-dist" text="{s:v}" hittest="false" /></Panel>
        <Panel id="mhud_js_h3" class="js-hist" hittest="false"><Label id="mhud_js_h3_t" class="js-hist-type" text="{s:v}" hittest="false" /><Label id="mhud_js_h3_i" class="js-hist-info" text="{s:v}" hittest="false" /><Label id="mhud_js_h3_d" class="js-hist-dist" text="{s:v}" hittest="false" /></Panel>
        <Panel id="mhud_js_h4" class="js-hist" hittest="false"><Label id="mhud_js_h4_t" class="js-hist-type" text="{s:v}" hittest="false" /><Label id="mhud_js_h4_i" class="js-hist-info" text="{s:v}" hittest="false" /><Label id="mhud_js_h4_d" class="js-hist-dist" text="{s:v}" hittest="false" /></Panel>
      </Panel>
      <Panel id="mhud_js_panel" class="js-panel" hittest="false">
        <Panel class="js-header" hittest="false">
          <Label id="mhud_js_type" class="js-type" text="{s:v}" hittest="false" />
          <Label id="mhud_js_tier" class="js-tier-name" text="{s:v}" hittest="false" />
        </Panel>
        <Label id="mhud_js_dist" class="js-dist" text="{s:v}" hittest="false" />
        <Panel class="js-divider" hittest="false" />
        <Panel class="js-row" hittest="false"><Label id="mhud_js_l0" class="js-label" text="{s:v}" hittest="false" /><Label id="mhud_js_v0" class="js-value" text="{s:v}" hittest="false" /></Panel>
        <Panel class="js-row" hittest="false"><Label id="mhud_js_l1" class="js-label" text="{s:v}" hittest="false" /><Label id="mhud_js_v1" class="js-value" text="{s:v}" hittest="false" /></Panel>
        <Panel class="js-row" hittest="false"><Label id="mhud_js_l2" class="js-label" text="{s:v}" hittest="false" /><Label id="mhud_js_v2" class="js-value" text="{s:v}" hittest="false" /></Panel>
        <Panel class="js-row" hittest="false"><Label id="mhud_js_l3" class="js-label" text="{s:v}" hittest="false" /><Label id="mhud_js_v3" class="js-value" text="{s:v}" hittest="false" /></Panel>
        <Panel class="js-row" hittest="false"><Label id="mhud_js_l4" class="js-label" text="{s:v}" hittest="false" /><Label id="mhud_js_v4" class="js-value" text="{s:v}" hittest="false" /></Panel>
        <Panel class="js-row" hittest="false"><Label id="mhud_js_l5" class="js-label" text="{s:v}" hittest="false" /><Label id="mhud_js_v5" class="js-value" text="{s:v}" hittest="false" /></Panel>
        <Panel class="js-row" hittest="false"><Label id="mhud_js_l6" class="js-label" text="{s:v}" hittest="false" /><Label id="mhud_js_v6" class="js-value" text="{s:v}" hittest="false" /></Panel>
        <Panel class="js-row" hittest="false"><Label id="mhud_js_l7" class="js-label" text="{s:v}" hittest="false" /><Label id="mhud_js_v7" class="js-value" text="{s:v}" hittest="false" /></Panel>
        <Panel class="js-row" hittest="false"><Label id="mhud_js_l8" class="js-label" text="{s:v}" hittest="false" /><Label id="mhud_js_v8" class="js-value" text="{s:v}" hittest="false" /></Panel>
        <Panel class="js-row" hittest="false"><Label id="mhud_js_l9" class="js-label" text="{s:v}" hittest="false" /><Label id="mhud_js_v9" class="js-value" text="{s:v}" hittest="false" /></Panel>
        <Panel class="js-row" hittest="false"><Label id="mhud_js_l10" class="js-label" text="{s:v}" hittest="false" /><Label id="mhud_js_v10" class="js-value" text="{s:v}" hittest="false" /></Panel>
      </Panel>
    </Panel>

    <Panel id="mhud_guide_x_pos" class="pos" hittest="false">
      <Panel id="mhud_guide_x" class="guide guide-x hidden" hittest="false" />
    </Panel>
    <Panel id="mhud_guide_y_pos" class="pos" hittest="false">
      <Panel id="mhud_guide_y" class="guide guide-y hidden" hittest="false" />
    </Panel>

    <Panel id="mhud_edit_bar" class="edit-bar hidden" hittest="false">
      <Label id="mhud_edit_hint" class="edit-hint" text="{s:edithint}" hittest="false" />
      <Panel id="mhud_edit_keys" class="edit-keys hidden" hittest="false">
        <Label id="mhud_edit_key_place" class="edit-key" text="{g:csgo_key:editkey}" hittest="false" />
        <Label id="mhud_edit_place" class="edit-hint" text="{s:editplace}" hittest="false" />
        <Label id="mhud_edit_key_cancel" class="edit-key" text="{g:csgo_key:editkey}" hittest="false" />
        <Label id="mhud_edit_cancel" class="edit-hint" text="{s:editcancel}" hittest="false" />
        <Label id="mhud_edit_key_default" class="edit-key" text="{g:csgo_key:editkey}" hittest="false" />
        <Label id="mhud_edit_default" class="edit-hint" text="{s:editdefault}" hittest="false" />
        <Label id="mhud_edit_key_free" class="edit-key" text="{g:csgo_key:editkey}" hittest="false" />
        <Label id="mhud_edit_free" class="edit-hint" text="{s:editfree}" hittest="false" />
      </Panel>
      <Button id="mhud_edit_done" class="edit-done">
        <Label id="mhud_edit_done_label" class="edit-done-label" text="{s:editdone}" hittest="false" />
      </Button>
    </Panel>
  </Panel>
</root>
